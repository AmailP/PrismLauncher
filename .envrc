PATH_add "$(asdf where cmake)/bin"
PATH_add "$(asdf where ninja)/bin"
PATH_add "$(asdf where java)/bin"

export VCPKG_ROOT="$HOME/src/vcpkg"
export JAVA_HOME="$(asdf where java)"
export CMAKE_PREFIX_PATH="$(brew --prefix qt)"
export CMAKE_OSX_DEPLOYMENT_TARGET="12"
export NINJA="$(asdf where ninja)/bin/ninja"
